# 복사해서 .env로 만들고 값을 채운다. .env는 커밋하지 않는다.
# 로컬: compose.yaml(MySQL)과 Spring(application.properties의 spring.config.import)이 같이 읽는다.

# 운영(prod)에서만 쓴다. 로컬은 localhost 고정
DB_HOST=
# 로컬은 3307 (다른 프로젝트 MySQL과 포트가 겹치지 않게)
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
# compose의 MySQL 컨테이너 root 비밀번호. Spring은 쓰지 않는다
DB_ROOT_PASSWORD=

# JWT 서명 키. 32바이트 이상 임의 문자열 (예: openssl rand -hex 32)
JWT_SECRET=
